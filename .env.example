# Copia questo file in ".env" e compila solo le sezioni che vuoi collegare.
# Qualsiasi fonte lasciata vuota userà automaticamente dati di esempio (mock).

# --- Twitter / X ---
# Crea un progetto su https://developer.twitter.com/ e genera un Bearer Token.
TWITTER_BEARER_TOKEN=
# Modo consigliato: usa una X List (lista curata di account).
# L'ID è il numero nell'URL della lista, es: https://x.com/i/lists/1234567890123456789
# NB: l'endpoint delle liste richiede un piano API a pagamento (Basic o superiore),
# non disponibile nel piano gratuito.
TWITTER_LIST_ID=
# In alternativa, se non usi una lista: account singoli separati da virgola.
# Usato solo se TWITTER_LIST_ID è vuoto. Es: nasa,github,ycombinator
TWITTER_USERNAMES=

# --- Telegram ---
# Nome utente del canale PUBBLICO da seguire (senza @), es: durov
# Non serve creare un bot: viene letto dall'anteprima pubblica del canale.
# Funziona solo con canali pubblici, non con canali privati.
TELEGRAM_CHANNEL=

# --- Email (IMAP) ---
# Funziona con qualsiasi account, anche diverso da quello eventualmente
# collegato a Claude: le credenziali restano solo in questo file locale.
# Per Gmail: abilita la verifica in due passaggi e crea una "App Password"
# su https://myaccount.google.com/apppasswords (host: imap.gmail.com)
# Outlook/Hotmail: host imap-mail.outlook.com
# Yahoo: host imap.mail.yahoo.com
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=
