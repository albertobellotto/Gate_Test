# Copia questo file in ".env" e compila solo le sezioni che vuoi collegare.
# Qualsiasi fonte lasciata vuota userà automaticamente dati di esempio (mock).

# --- Twitter / X ---
# Crea un progetto su https://developer.twitter.com/ e genera un Bearer Token.
TWITTER_BEARER_TOKEN=
# Elenco separato da virgole degli account da seguire, es: nasa,github,ycombinator
TWITTER_USERNAMES=

# --- Telegram ---
# Crea un bot con @BotFather su Telegram e ottieni il token.
# Aggiungi il bot come admin ai canali che vuoi monitorare.
TELEGRAM_BOT_TOKEN=

# --- Email (IMAP) ---
# Per Gmail: abilita la verifica in due passaggi e crea una "App Password"
# su https://myaccount.google.com/apppasswords
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=
